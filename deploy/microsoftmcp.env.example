# Copy to /etc/microsoftmcp/microsoftmcp.env, mode 0640, owner root:microsoftmcp.
# Systemd reads the values literally: no quotes, no export.

# The public URI of the MCP endpoint, exactly as in the registry of the auth server.
MICROSOFTMCP_RESOURCE_URI=https://m365.example.com/mcp
# The public base URL of the auth server.
MICROSOFTMCP_AUTH_ISSUER=https://auth.example.com
# The internal listener of the auth server (default shown).
MICROSOFTMCP_AUTH_INTERNAL_URL=http://127.0.0.1:8101
# service_id and secret of this server in the registry; only the hash of the secret goes into the registry.
MICROSOFTMCP_SERVICE_ID=microsoftmcp
MICROSOFTMCP_SERVICE_SECRET=replace-with-the-service-secret

MICROSOFTMCP_PORT=8090
MICROSOFTMCP_STORE=postgres
MICROSOFTMCP_DB=DriverID=PG;Server=127.0.0.1;Port=5432;Database=microsoftmcp;User_Name=microsoftmcp;Password=replace-me

# Optional: only needed when several instances serve the same clients (see README).
# MICROSOFTMCP_REQUEST_STATE_KEY=
